# ── ZoikoMeds environment ──────────────────────────────────────────────
# Copy to .env.local and adjust as needed.

# Backend platform API (ZoikoMeds API — see ZoikoMeds.postman_collection.json)
NEXT_PUBLIC_API_URL=https://get.zoikomeds.com/api

# The authenticated frontend app (login, dashboards, portals)
NEXT_PUBLIC_APP_URL=https://zoiko-meds-platform.vercel.app

# Server-only keys (used by /app/api/* routes — not exposed to the client)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Live Pharmacy Inventory API URL
# LIVE_INVENTORY_API_URL=https://api.zoikomeds.com/v1/live-inventory
# LIVE_INVENTORY_API_KEY=
# LIVE_INVENTORY_TIMEOUT_MS=3000
# Google Geocoding / Places — server-side only, never NEXT_PUBLIC_
# GOOGLE_PLACES_API_KEY=

# ── Outbound email (website forms) ─────────────────────────────────────
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_ — that would ship
# the mailbox password to the browser.
#
# Every form sends two emails: an internal notification to info@zoikomeds.com
# (fixed in lib/email/transport.ts, not configurable by a request) and a
# confirmation to the address the visitor entered. With these unset, forms still
# validate, save and return success — they just cannot send.
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=info@zoikomeds.com
# SMTP_PASSWORD=
# Optional: the From header. Defaults to "ZoikoMeds" <SMTP_USER>.
# SMTP_FROM_ADDRESS=info@zoikomeds.com
# SMTP_FROM_NAME=ZoikoMeds
# Optional: force TLS when the port is not 465.
# SMTP_USE_SSL=false
# Optional: verify the SMTP server's certificate. Off by default to match the
# current host; turn on once that host's chain has been checked.
# SMTP_REQUIRE_VALID_CERT=false
# Optional: IANA zone used to format submission times when a visitor's browser
# reports none. Defaults to UTC.
# APP_TIMEZONE=UTC
