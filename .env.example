# ── ZoikoMeds environment ──────────────────────────────────────────────
# Copy to .env.local and adjust as needed.

# Backend platform API (ZoikoMeds API — see ZoikoMeds.postman_collection.json)
NEXT_PUBLIC_API_URL=https://get.zoikomeds.com/api

# The authenticated frontend app (login, dashboards, portals)
NEXT_PUBLIC_APP_URL=https://zoiko-meds-platform.vercel.app

# Server-only keys (used by /app/api/* routes — not exposed to the client)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Live Pharmacy Inventory API URL
# LIVE_INVENTORY_API_URL=https://api.zoikomeds.com/v1/live-inventory
# LIVE_INVENTORY_API_KEY=
# LIVE_INVENTORY_TIMEOUT_MS=3000
# Google Geocoding / Places — server-side only, never NEXT_PUBLIC_
# GOOGLE_PLACES_API_KEY=
